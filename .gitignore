# Build output
/bomdive
/dist/
/bin/
*.exe
*.dll
*.so
*.dylib

# Test and coverage artifacts
*.test
*.out
coverage.*

# Go workspace
go.work
go.work.sum

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# BOM scan artifacts (generated; commit only a deliberate release BOM)
*.cdx.json
# cdxgen's default output name, which no *.cdx.* pattern catches:
/bom.json
*.cdx.xml
*.spdx.json
!testdata/**/*.cdx.json
!testdata/**/*.cdx.xml

# Secrets and credentials
.env
.env.*
!.env.example
.envrc
.envrc.local
*.pem
*.key
credentials.json
secrets.yaml

# Claude Code local files
CLAUDE.local.md
testdata/.schema-cache/
.conformance-cache/
.corpora-cache/
.corpora-cache-vex/
*.local.*
